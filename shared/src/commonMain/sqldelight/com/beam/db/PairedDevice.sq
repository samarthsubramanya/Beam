CREATE TABLE PairedDevice (
    id TEXT NOT NULL PRIMARY KEY,
    displayName TEXT NOT NULL,
    pairedAtEpochMillis INTEGER NOT NULL
);

selectAll:
SELECT * FROM PairedDevice;

selectById:
SELECT * FROM PairedDevice WHERE id = ?;

insertOrReplace:
INSERT OR REPLACE INTO PairedDevice(id, displayName, pairedAtEpochMillis) VALUES (?, ?, ?);

deleteById:
DELETE FROM PairedDevice WHERE id = ?;
